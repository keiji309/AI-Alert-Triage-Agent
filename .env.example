# Required for LLM-backed triage. Leave empty to run the fully-deterministic
# fail-safe tier (works offline, 0 tokens, good for CI/tests).
ANTHROPIC_API_KEY=

# Model used for triage investigations. Defaults to a quality/speed balance.
# Cheaper option: claude-haiku-4-5
TRIAGE_MODEL=claude-sonnet-4-5

# Max output tokens per LLM call and max tool-call iterations per case.
MAX_TOKENS=4096
MAX_TOOL_ITERATIONS=12

# Override the synthetic seed for reproducible demo data (any int).
DEMO_SEED=1337

# Windows in minutes for correlation and evidence lookups.
CORRELATION_WINDOW_MINUTES=45

# Optional live threat-intel enrichment (AbuseIPDB). Empty = bundled local table.
ABUSEIPDB_API_KEY=